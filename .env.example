# Required for API + CLI LLM
GROQ_API_KEY=

# Required for HF Inference embeddings + reranker (Inference Providers permission)
HF_TOKEN=

# Optional
GROQ_MODEL=llama-3.3-70b-versatile

# true = HF API for BGE-M3 + reranker (matches requirements.txt — no local model pip deps).
# false = local sentence-transformers in rag_chatbot_groq.py (install that package yourself).
USE_HF_INFERENCE=true
